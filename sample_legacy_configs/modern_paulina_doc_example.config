# Upstream Migrated Configuration (v1 Standard)
# Generated automatically using upstream-config-migrator SKILL.md

<source>
    @type tail
    path /var/log/my-app.log
  <parse>
    @type json
    # NOTE: auto_typecast directive stripped (unsupported in v1 JSON parser)
  </parse>
</source>

<filter foo.bar>
  @type record_transformer
  enable_ruby true
  <record>
    raw_timestamp ${time.to_i}
  </record>
</filter>

<match **>
  @type google_cloud
  use_grpc true
  grpc_compression_algorithm gzip
  <buffer>
    @type file
    path /var/log/google-fluentd/buffers
    chunk_limit_size 512KB
    flush_interval 5s
    retry_forever false
    retry_max_times 3
    retry_wait 10
    retry_max_interval 300
    flush_thread_count 8
  </buffer>
  # NOTE: partial_success directive stripped (permanently enabled in v1)
</match>
