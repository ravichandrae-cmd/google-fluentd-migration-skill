# Legacy Java App & RabbitMQ Logging Configuration
<source>
  @type http
  port 8080
  bind 0.0.0.0
  body_size_limit 64m
  keep_alive_timeout 15s
  tag java.http.app
  <parse>
    @type json
    # NOTE: auto_typecast directive stripped (unsupported in upstream parser)
  </parse>
</source>

<source>
  @type tail
  path /var/log/rabbitmq/rabbit@localhost.log
  pos_file /var/log/fluentd/rabbitmq.pos
  tag rabbitmq.server
  <parse>
    @type multiline
    format_firstline /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}/
    format1 /(?<time>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) \[(?<level>\w+)\] <(?<pid>\d+\.\d+\.\d+)> (?<message>.*)/
  </parse>
</source>

<filter java.http.app>
  @type detect_exceptions
  remove_tag_prefix input
  message message
  languages ["java"]
</filter>

<match **>
  use_grpc true
  @type google_cloud
    # NOTE: auto_typecast directive stripped (unsupported in upstream parser)
  grpc_compression_algorithm gzip
  custom_legacy_routing_key "app-logs"
</match>
